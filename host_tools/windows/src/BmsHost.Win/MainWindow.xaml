<Window x:Class="BmsHost.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telink BMS Host - Windows" Height="900" Width="1320"
        MinHeight="760" MinWidth="1080" Closing="Window_Closing">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" BorderBrush="#808080" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Transport:" FontWeight="Bold" Margin="0,0,8,0"/>
                    <RadioButton x:Name="SerialModeRadio" Content="Serial" IsChecked="True" Margin="4" Checked="TransportMode_Changed"/>
                    <RadioButton x:Name="BleModeRadio" Content="Bluetooth LE" Margin="4" Checked="TransportMode_Changed"/>
                </StackPanel>
                <TextBlock x:Name="ConnectionStatusText" Grid.Column="1" Text="Disconnected" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox x:Name="AutoRefreshCheck" Content="Auto refresh" IsChecked="True" VerticalAlignment="Center" Margin="4"/>
                    <TextBox x:Name="PollIntervalText" Text="1000" Width="70" ToolTip="Polling interval in milliseconds"/><TextBlock Text="ms"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <GroupBox Header="Serial" Grid.Column="0" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal" Margin="6">
                    <ComboBox x:Name="SerialPortCombo" Width="130"/>
                    <ComboBox x:Name="BaudCombo" Width="110" SelectedIndex="3"><ComboBoxItem Content="9600"/><ComboBoxItem Content="19200"/><ComboBoxItem Content="57600"/><ComboBoxItem Content="115200"/></ComboBox>
                    <Button Content="Refresh COM" Click="RefreshSerial_Click"/><Button x:Name="SerialConnectButton" Content="Connect Serial" Click="SerialConnect_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Bluetooth LE" Grid.Column="1" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="6">
                    <Button x:Name="BleScanButton" Content="Scan 4 s" Click="BleScan_Click"/>
                    <ComboBox x:Name="BleDeviceCombo" Width="430" DisplayMemberPath="Display"/>
                    <Button x:Name="BleConnectButton" Content="Connect BLE" Click="BleConnect_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <TextBox DockPanel.Dock="Bottom" x:Name="LogBox" Height="125" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Margin="0,8,0,0"/>

        <TabControl x:Name="MainTabs">
            <TabItem Header="Realtime">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <GroupBox Header="Pack">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Voltage"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="PackVoltageText" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Text="Current (+discharge)"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="CurrentText" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Text="SOC / SOH"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="SocSohText"/>
                                <TextBlock Grid.Row="3" Text="Cell max / min"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="CellExtremaText"/>
                                <TextBlock Grid.Row="4" Text="Cell delta"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="CellDeltaText"/>
                                <TextBlock Grid.Row="5" Text="Temp 1 / 2"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="TempsText"/>
                                <TextBlock Grid.Row="6" Text="AFE"/><TextBlock Grid.Row="6" Grid.Column="1" x:Name="AfeText"/>
                                <TextBlock Grid.Row="7" Text="Last update"/><TextBlock Grid.Row="7" Grid.Column="1" x:Name="LastUpdateText"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="MOS / Protection" Margin="0,8,0,0">
                            <StackPanel Margin="8"><TextBlock x:Name="MosText" Text="-"/><TextBlock x:Name="ProtectText" Text="-" TextWrapping="Wrap" Margin="0,4,0,4"/><StackPanel Orientation="Horizontal"><Button Content="MOS ON" Click="MosOn_Click"/><Button Content="MOS OFF" Click="MosOff_Click"/><Button Content="Refresh now" Click="RefreshNow_Click"/></StackPanel></StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <DataGrid Grid.Column="1" x:Name="CellsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="8,0,0,0"><DataGrid.Columns><DataGridTextColumn Header="Cell" Binding="{Binding Index}" Width="100"/><DataGridTextColumn Header="Voltage (V)" Binding="{Binding VoltageV, StringFormat=F3}" Width="180"/></DataGrid.Columns></DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Protection Parameters">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Read all" Click="ReadParameters_Click"/><Button Content="Write all" Click="WriteParameters_Click"/><TextBlock Text="Writes take effect immediately; firmware persistence follows its save delay." Margin="12,0,0,0"/></StackPanel>
                    <DataGrid x:Name="ProtectionGrid" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Protection" Binding="{Binding Name}" IsReadOnly="True" Width="150"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="70"/>
                            <DataGridTextColumn Header="L1" Binding="{Binding L1, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="L2" Binding="{Binding L2, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="L3" Binding="{Binding L3, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Recovery" Binding="{Binding Recovery, UpdateSourceTrigger=PropertyChanged}" Width="100"/><DataGridTextColumn Header="Delay (ms)" Binding="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Device / Diagnostics">
                <Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="Device identity" Margin="0,0,4,0"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Serial"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="SerialNumberText" IsReadOnly="True"/>
                        <TextBlock Grid.Row="1" Text="Hardware"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="HardwareVersionText" IsReadOnly="True"/>
                        <TextBlock Grid.Row="2" Text="Software"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="SoftwareVersionText" IsReadOnly="True"/>
                        <TextBlock Grid.Row="3" Text="Bluetooth name"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="BluetoothNameText"/>
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"><Button Content="Read identity" Click="ReadIdentity_Click"/><Button Content="Set BLE name" Click="SetBleName_Click"/></StackPanel>
                    </Grid></GroupBox>
                    <GroupBox Header="Diagnostics" Grid.Column="1" Margin="4,0,0,0"><TextBox x:Name="DiagnosticsText" Margin="8" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="OTA">
                <StackPanel Margin="12">
                    <TextBlock Text="Current firmware exposes Telink OTA through BLE GATT. Serial OTA stays disabled until firmware provides a matching serial-IAP protocol." TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="OtaFileText" Width="700" IsReadOnly="True"/><Button Content="Choose .bin" Click="ChooseOtaFile_Click"/></StackPanel>
                    <TextBlock x:Name="OtaFileInfoText" Margin="4"/><ProgressBar x:Name="OtaProgressBar" Minimum="0" Maximum="100" Height="28" Margin="4"/><TextBlock x:Name="OtaProgressText" Margin="4"/>
                    <StackPanel Orientation="Horizontal"><Button x:Name="StartOtaButton" Content="Start BLE OTA" Click="StartOta_Click"/><Button x:Name="CancelOtaButton" Content="Cancel" IsEnabled="False" Click="CancelOta_Click"/></StackPanel>
                    <TextBlock x:Name="OtaStatusText" TextWrapping="Wrap" Margin="4,12,4,4" FontWeight="SemiBold"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Raw Modbus">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Register (hex)"/><TextBox x:Name="RawRegisterText" Text="D120" Width="100"/><TextBlock Text="Quantity"/><TextBox x:Name="RawQuantityText" Text="11" Width="70"/><Button Content="FC03 Read" Click="RawRead_Click"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Register (hex)"/><TextBox x:Name="RawWriteRegisterText" Text="1102" Width="100"/><TextBlock Text="Value (hex/dec)"/><TextBox x:Name="RawWriteValueText" Text="0x0011" Width="100"/><Button Content="FC06 Write" Click="RawWrite_Click"/></StackPanel>
                    <TextBox x:Name="RawResultText" Height="350" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
